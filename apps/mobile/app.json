{
  "expo": {
    "name": "CareBridge",
    "slug": "carebridge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.carebridge.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock CareBridge with Face ID.",
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": false }
      }
    },
    "android": {
      "package": "com.carebridge.app",
      "allowBackup": false,
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": ["expo-secure-store", "expo-local-authentication"],
    "extra": {
      "apiUrl": "http://10.0.2.2:4000"
    }
  }
}
